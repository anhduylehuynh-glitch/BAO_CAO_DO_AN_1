#!/bin/bash
set -e

if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  ./bin/rails db:prepare
fi

echo "=== ĐANG KHỞI ĐỘNG DỊCH VỤ NỀN FLASK AI PORT 5000 ==="

# Chuyển vào thư mục ai-service và chạy ngầm bằng đường dẫn tương đối chuẩn xác
cd ai-service
python3 app.py > /tmp/flask_service.log 2>&1 &
cd ..

# Đợi 3 giây để Flask có thời gian khởi tạo cấu hình ban đầu
sleep 3

echo "=== KIỂM TRA TRẠNG THÁI FLASK ==="
cat /tmp/flask_service.log || true
echo "================================="

exec "$@"